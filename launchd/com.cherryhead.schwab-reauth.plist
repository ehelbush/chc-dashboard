<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cherryhead.schwab-reauth</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/ehelbush/projects/cherryhead/CHC-dashboard/schwab_reauth.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ehelbush/projects/cherryhead/CHC-dashboard</string>

    <!-- launchd uses a minimal PATH; add Homebrew (gh) and system bins (git). -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Every morning at 8:00 local (Sun=0 ... Sat=6). Runs all 7 days, not
         just weekdays: the 7-day refresh token can cross the 3-day re-auth
         threshold on a weekend, and a weekday-only schedule would miss it and
         let the token expire (which is exactly what happened June 2026). The
         script only opens the browser when within REAUTH_THRESHOLD_DAYS of
         expiry, so on most mornings it checks and exits silently. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/ehelbush/projects/cherryhead/CHC-dashboard/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ehelbush/projects/cherryhead/CHC-dashboard/logs/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
